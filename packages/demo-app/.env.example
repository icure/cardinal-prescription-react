# Copy this file to `.env.local` (which is gitignored) and fill in your values.
#
# How to obtain the practitioner credentials:
# 1. Go to https://cockpit.icure.dev/ — the management platform for Cardinal.
# 2. Register and log in.
# 3. Create a solution, then a database, and then a healthcare professional (HCP).
# 4. For this HCP, generate an Active Authentication Token.
# 5. Use the HCP's email address as REACT_APP_ICURE_USERNAME and the token as REACT_APP_ICURE_PASSWORD.

REACT_APP_ICURE_USERNAME=your.email@example.com
REACT_APP_ICURE_PASSWORD=your-active-authentication-token

# Environment endpoints (defaults shown; override for acc/prod as needed).
# The @icure/cardinal-be-sam-sdk SAM v2 endpoints are available on nightly.
REACT_APP_ICURE_URL=https://nightly.icure.cloud
REACT_APP_FHC_URL=https://fhcacc.icure.cloud

# UI language: fr | nl | de | en
REACT_APP_CARDINAL_LANGUAGE=fr
